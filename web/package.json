{
  "name": "web",
  "version": "1.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/imorekt/satsetvidual.git"
  },
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "build:exe": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.satsetvidual.app",
    "afterPack": "./afterPack.js",
    "productName": "satsetvidual",
    "icon": "icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "icon.png",
      "package.json",
      "!/node_modules"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "imorekt",
        "repo": "websell"
      }
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules"
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@cosmjs/crypto": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@mysten/sui.js": "^0.54.1",
    "@solana/web3.js": "^1.98.4",
    "@uniswap/universal-router-sdk": "^5.11.3",
    "bs58": "^6.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "ethers": "^6.17.0",
    "lightweight-charts": "^4.2.0",
    "next": "16.2.10",
    "nodemailer": "^9.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4"
  }
}
